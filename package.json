{
  "name": "simple-server",
  "version": "2.0.0",
  "description": "Zero-dependency Node static server for a single-page app: safe paths, brotli, caching, SPA fallback, PWA. 100/100 Lighthouse out of the box, agent-friendly, with an optional MCP endpoint.",
  "type": "module",
  "main": "lib/simple-server.js",
  "exports": {
    ".": "./lib/simple-server.js"
  },
  "bin": {
    "simple-server": "server.js"
  },
  "files": [
    "lib",
    "server.js",
    "public"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "VERBOSE=1 node --watch server.js",
    "mcp": "MCP=1 node server.js",
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "vendor": "node scripts/vendor.mjs",
    "shots": "node scripts/shots.mjs",
    "cert": "openssl req -x509 -newkey rsa:2048 -nodes -days 825 -keyout key.pem -out cert.pem -subj /CN=localhost -addext subjectAltName=DNS:localhost,IP:127.0.0.1",
    "fireworks": "node scripts/fireworks.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hertonwork/server.git"
  },
  "homepage": "https://server.herton.work",
  "bugs": {
    "url": "https://github.com/hertonwork/server/issues"
  },
  "keywords": [
    "static-server",
    "spa",
    "pwa",
    "service-worker",
    "http",
    "zero-dependencies",
    "node",
    "lighthouse",
    "minim",
    "sscss",
    "agents",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Herton (https://github.com/hertonwork)",
  "license": "MIT"
}
